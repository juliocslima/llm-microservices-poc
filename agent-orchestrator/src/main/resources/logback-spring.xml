<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} traceId=%X{traceId} spanId=%X{spanId} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Loki appender - sends structured logs to Loki for the observability stack -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <!-- URL is overridden by LOKI_URL env var at runtime -->
            <url>${LOKI_URL:-http://localhost:3100}/loki/api/v1/push</url>
        </http>
        <format>
            <label>
                <pattern>service=${spring.application.name:-unknown},level=%level,host=${HOSTNAME:-local}</pattern>
            </label>
            <message>
                <pattern>
                    {
                        "level": "%level",
                        "message": "%msg",
                        "logger": "%logger",
                        "thread": "%thread",
                        "traceId": "%X{traceId}",
                        "spanId": "%X{spanId}",
                        "service": "${spring.application.name:-unknown}"
                    }
                </pattern>
            </message>
        </format>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="LOKI"/>
    </root>

    <logger name="br.ufla.poc" level="DEBUG"/>
    <logger name="dev.langchain4j" level="DEBUG"/>
    <logger name="org.springframework.web" level="INFO"/>
    <logger name="org.hibernate" level="WARN"/>
</configuration>
